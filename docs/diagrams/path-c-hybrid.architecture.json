  "cards": [
    {
      "dot": "cyan",
      "title": "Sequence",
      "items": [
        "Phase 0: core library with golden tests",
        "Phase 1: web runtime tier, no backend, no drivers",
        "Phase 2: cloud build + browser flash",
        "Phase 3: desktop shell for installers and offline"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why",
      "items": [
        "Zero-install first release for CFX/Xeno migrants",
        "Expensive decisions (signing, compile farm) deferred until usage justifies them",
        "Highest long-term ceiling: union of web and desktop"
      ]
    },
    {
      "dot": "rose",
      "title": "Still impossible",
      "items": [
        "New style structures without a compile",
        "Blade layout or prop changes without a reflash",
        "Skipping the Windows bootloader driver"
      ]
    }
  ]
