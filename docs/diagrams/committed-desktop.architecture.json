  "cards": [
    {
      "dot": "cyan",
      "title": "Process split",
      "items": [
        "Renderer: UI plus the board bridge on Electron Web Serial / WebUSB, no native modules",
        "Main: toolchain, build, flash, SD manager, backups, updater as subprocesses and files",
        "Core: pure TypeScript imported by both, golden-tested"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sequencing",
      "items": [
        "Phase 1 ships Tier 1 runtime editing and SD management with no toolchain",
        "Phase 2 adds local build, flash meter, flash engine, Windows driver wizard",
        "Phase 3 adds style library, CFX/Xeno import, update tracking"
      ]
    },
    {
      "dot": "rose",
      "title": "Invariants",
      "items": [
        "BladeConfig is saber identity, never silently regenerated",
        "No flash without a full backup and presets.ini snapshot",
        "Users compile their own firmware; nothing is served from a cloud"
      ]
    }
  ]
