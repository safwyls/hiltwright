{
  "name": "hiltwright",
  "version": "0.2.0-beta.14",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "ProffieOS for people who never want to see a compiler. Workspace root; see docs/00-plan.md.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test --workspace @hiltwright/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace @hiltwright/desktop",
    "dist": "npm run dist --workspace @hiltwright/desktop",
    "build": "npm run build --workspace @hiltwright/desktop"
  }
}
