{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-canvas",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "design"],
      "port": 8765
    },
    {
      "name": "repo-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8766", "--bind", "127.0.0.1"],
      "port": 8766
    },
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": ["site/serve.mjs"],
      "port": 4173
    },
    {
      "name": "site-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4175", "--bind", "127.0.0.1", "--directory", "site/dist"],
      "port": 4175
    },
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "demo", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
