{
  "name": "@hiltwright/desktop",
  "version": "0.2.0-beta.16",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Hiltwright desktop app (Electron). Walking skeleton: connect to a Proffieboard over Web Serial, read version and presets.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "fontpacks": "node scripts/fontpacks.mjs",
    "voicepacks": "node scripts/voicepacks.ts",
    "dist": "node scripts/fontpacks.mjs --check && node scripts/voicepacks.ts --check && electron-vite build && electron-builder --win --publish never",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "icons": "electron scripts/icons.mjs",
    "crystal": "electron scripts/crystal.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@hiltwright/core": "*",
    "electron-updater": "^6.8.11",
    "pixi.js": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.170.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "45.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.hiltwright.desktop",
    "productName": "Hiltwright",
    "afterPack": "./build/afterPack.mjs",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "safwyls",
        "repo": "hiltwright",
        "releaseType": "prerelease"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/builtin",
        "to": "builtin"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "resources/voicepack",
        "to": "voicepack",
        "filter": [
          "*.zip",
          "catalogue.json"
        ]
      },
      {
        "from": "resources/packs",
        "to": "packs",
        "filter": [
          "*.hwpack"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hiltwright-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "license": "../../LICENSE",
      "artifactName": "Hiltwright-${version}-setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Hiltwright-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "npmRebuild": false
  },
  "author": "safwyls"
}
