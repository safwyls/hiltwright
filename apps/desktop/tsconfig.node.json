{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "src/shared", "electron.vite.config.ts", "vitest.config.ts", "test"],
  // Tests of renderer modules that reach the browser APIs are checked with the renderer config instead.
  "exclude": ["test/draftModel.test.ts", "test/staged.test.ts", "test/fontEngine.test.ts", "test/tour.test.ts", "test/armoryRemove.test.ts", "test/firmwareLine.test.ts"]
}
